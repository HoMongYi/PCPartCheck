{
  "name": "@pcpartcheck/provider-buildcores",
  "version": "0.1.0",
  "description": "BuildCores OpenDB snapshot adapter for PCPartCheck",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pcpartcheck/core": "workspace:*",
    "@pcpartcheck/identity": "workspace:*",
    "@pcpartcheck/provider-sdk": "workspace:*",
    "@pcpartcheck/unit-normalization": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "publishConfig": {
    "access": "public"
  }
}
