{
  "name": "@pcpartcheck/http-server",
  "version": "0.1.0",
  "description": "Fastify reference server for PCPartCheck",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@pcpartcheck/api-contracts": "workspace:*",
    "fastify": "5.12.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "publishConfig": {
    "access": "public"
  }
}
