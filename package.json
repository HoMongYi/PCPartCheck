{
  "name": "pcpartcheck",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral PC parts compatibility engine",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.3.4 <13"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "check:deps": "node scripts/check-dependency-graph.mjs",
    "docs:check-links": "node scripts/check-documentation.mjs",
    "docs:diagram": "node scripts/generate-diagrams.mjs",
    "docs:openapi": "corepack pnpm build && node scripts/generate-openapi.mjs",
    "docs:screenshot": "corepack pnpm build && node scripts/capture-demo-screenshot.mjs",
    "lint": "eslint .",
    "pack:check": "corepack pnpm build && node scripts/check-package-packs.mjs",
    "test": "vitest run",
    "test:e2e": "corepack pnpm build && playwright test",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "typecheck": "tsc --noEmit",
    "version:check": "corepack pnpm build && node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "better-sqlite3": "13.0.3",
    "eslint": "10.10.0",
    "mermaid": "11.17.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
