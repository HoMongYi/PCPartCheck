{
  "name": "pcpartcheck",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral PC parts compatibility engine",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.3.4 <13"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "check:deps": "node scripts/check-dependency-graph.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:unit": "vitest run --exclude tests/integration/**",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "better-sqlite3": "13.0.3",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
