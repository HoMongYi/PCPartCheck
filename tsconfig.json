{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@pcpartcheck/api-contracts": [
        "./packages/api-contracts/src/index.ts"
      ],
      "@pcpartcheck/core": ["./packages/core/src/index.ts"],
      "@pcpartcheck/evidence": ["./packages/evidence/src/index.ts"],
      "@pcpartcheck/identity": ["./packages/identity/src/index.ts"],
      "@pcpartcheck/http-server": ["./packages/http-server/src/index.ts"],
      "@pcpartcheck/llm-toolkit": ["./packages/llm-toolkit/src/index.ts"],
      "@pcpartcheck/power": ["./packages/power/src/index.ts"],
      "@pcpartcheck/provider-buildcores": [
        "./packages/provider-buildcores/src/index.ts"
      ],
      "@pcpartcheck/provider-sdk": ["./packages/provider-sdk/src/index.ts"],
      "@pcpartcheck/rules-standard": [
        "./packages/rules-standard/src/index.ts"
      ],
      "@pcpartcheck/similarity": ["./packages/similarity/src/index.ts"],
      "@pcpartcheck/storage-sqlite": [
        "./packages/storage-sqlite/src/index.ts"
      ],
      "@pcpartcheck/unit-normalization": [
        "./packages/unit-normalization/src/index.ts"
      ]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/test/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
